{
  "schema_version": "1.0",
  "suite": "products-web-v2",
  "repetitions": 3,
  "conditions": [
    "executor_only",
    "agentarch"
  ],
  "common_requirements": "Build a local HTTP application in the requested language. Listen only on HOST=127.0.0.1 and PORT from environment. GET /health must return 200 {\"ok\":true}. API responses including errors must be JSON. GET / must return a minimal functional HTML page for this product: users can create at least one valid domain record through a labelled form and see the resulting state without using a terminal. Include document language, descriptive title, one h1, programmatic labels for inputs, native keyboard-operable submit buttons, visible focus and a status/error region with role=status or aria-live. No external CDN/assets/services. Include real headless-browser tests for a successful UI mutation and its visible result, keyboard submit, input labels and feedback; TypeScript test:a11y must execute these checks, and Python pytest must include them. A script that merely exits successfully or asserts no UI exists does not satisfy accessibility. Persist application data exclusively under DATA_DIR; never change source during startup or requests. Include meaningful repository tests and startup instructions. The checks are a public contract, not hidden tests.",
  "scenarios": [
    {
      "id": "python-tasks",
      "language": "python",
      "profile": "python-api",
      "title": "Task tracker",
      "requirements": "Create tasks with caller-supplied unique id and nonblank title. New tasks have done=false. PATCH accepts only a boolean done. Reject invalid input with 400 and duplicate ids with 409. Persist changes across process restart.",
      "checks": [
        {
          "id": "ui-surface",
          "method": "GET",
          "path": "/",
          "status": 200,
          "response_type": "html",
          "assertions": {
            "language": true,
            "title": true,
            "heading": true,
            "labelled_controls": true,
            "submit_button": true,
            "status_region": true
          }
        },
        {
          "id": "create",
          "method": "POST",
          "path": "/tasks",
          "status": 201,
          "assertions": {
            "/id": "t1",
            "/title": "Review PR",
            "/done": false
          },
          "body": {
            "id": "t1",
            "title": "Review PR"
          }
        },
        {
          "id": "duplicate",
          "method": "POST",
          "path": "/tasks",
          "status": 409,
          "assertions": {},
          "body": {
            "id": "t1",
            "title": "Overwrite"
          }
        },
        {
          "id": "invalid",
          "method": "POST",
          "path": "/tasks",
          "status": 400,
          "assertions": {},
          "body": {
            "id": "t2",
            "title": ""
          }
        },
        {
          "id": "complete",
          "method": "PATCH",
          "path": "/tasks/t1",
          "status": 200,
          "assertions": {
            "/done": true
          },
          "body": {
            "done": true
          }
        },
        {
          "id": "invalid-type",
          "method": "PATCH",
          "path": "/tasks/t1",
          "status": 400,
          "assertions": {},
          "body": {
            "done": "false"
          }
        },
        {
          "id": "durability-restart",
          "restart": true
        },
        {
          "id": "persisted",
          "method": "GET",
          "path": "/tasks/t1",
          "status": 200,
          "assertions": {
            "/title": "Review PR",
            "/done": true
          }
        },
        {
          "id": "missing",
          "method": "GET",
          "path": "/tasks/missing",
          "status": 404,
          "assertions": {}
        }
      ]
    },
    {
