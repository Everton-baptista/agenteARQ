    {
      "id": "python-inventory",
      "language": "python",
      "profile": "python-api",
      "title": "Inventory adjustments",
      "requirements": "PUT /items/{id} creates an item with nonnegative integer quantity (201), duplicate id=409. POST /items/{id}/adjust changes quantity by integer delta, returns updated item; rejects a negative resulting quantity with 409 and noninteger delta with 400. Missing item=404. Rejected updates must leave state unchanged; persist across restart.",
      "checks": [
        {
          "id": "ui-surface",
          "method": "GET",
          "path": "/",
          "status": 200,
          "response_type": "html",
          "assertions": {
            "language": true,
            "title": true,
            "heading": true,
            "labelled_controls": true,
            "submit_button": true,
            "status_region": true
          }
        },
        {
          "id": "create",
          "method": "PUT",
          "path": "/items/sku1",
          "status": 201,
          "assertions": {
            "/id": "sku1",
            "/quantity": 3
          },
          "body": {
            "quantity": 3
          }
        },
        {
          "id": "duplicate",
          "method": "PUT",
          "path": "/items/sku1",
          "status": 409,
          "assertions": {},
          "body": {
            "quantity": 8
          }
        },
        {
          "id": "decrement",
          "method": "POST",
          "path": "/items/sku1/adjust",
          "status": 200,
          "assertions": {
            "/quantity": 1
          },
          "body": {
            "delta": -2
          }
        },
        {
          "id": "oversell",
          "method": "POST",
          "path": "/items/sku1/adjust",
          "status": 409,
          "assertions": {},
          "body": {
            "delta": -2
          }
        },
        {
          "id": "fraction",
          "method": "POST",
          "path": "/items/sku1/adjust",
          "status": 400,
          "assertions": {},
          "body": {
            "delta": 0.5
          }
        },
        {
          "id": "missing",
          "method": "POST",
          "path": "/items/missing/adjust",
          "status": 404,
          "assertions": {},
          "body": {
            "delta": 1
          }
        },
        {
          "id": "durability-restart",
          "restart": true
        },
        {
          "id": "persisted",
          "method": "GET",
          "path": "/items/sku1",
          "status": 200,
          "assertions": {
            "/quantity": 1
          }
        }
      ]
    },
