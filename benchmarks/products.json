    {
      "id": "python-events",
      "language": "python",
      "profile": "python-api",
      "title": "Idempotent event inbox",
      "requirements": "POST /events accepts nonblank id/type and object payload. First delivery returns 201 with duplicate=false. Repeated id returns 200 duplicate=true without overwriting the first event, even after restart. Invalid event=400. GET /events/{id} returns original {id,type,payload}; missing=404. Persist across restart.",
      "checks": [
        {
          "id": "ui-surface",
          "method": "GET",
          "path": "/",
          "status": 200,
          "response_type": "html",
          "assertions": {
            "language": true,
            "title": true,
            "heading": true,
            "labelled_controls": true,
            "submit_button": true,
            "status_region": true
          }
        },
        {
          "id": "create",
          "method": "POST",
          "path": "/events",
          "status": 201,
          "assertions": {
            "/duplicate": false
          },
          "body": {
            "id": "ev1",
            "type": "order.created",
            "payload": {
              "order_id": "o1"
            }
          }
        },
        {
          "id": "retry",
          "method": "POST",
          "path": "/events",
          "status": 200,
          "assertions": {
            "/duplicate": true
          },
          "body": {
            "id": "ev1",
            "type": "tampered",
            "payload": {
              "order_id": "o2"
            }
          }
        },
        {
          "id": "invalid",
          "method": "POST",
          "path": "/events",
          "status": 400,
          "assertions": {},
          "body": {
            "type": "missing.id",
            "payload": {}
          }
        },
        {
          "id": "durability-restart",
          "restart": true
        },
        {
          "id": "original",
          "method": "GET",
          "path": "/events/ev1",
          "status": 200,
          "assertions": {
            "/id": "ev1",
            "/type": "order.created",
            "/payload": {
              "order_id": "o1"
            }
          }
        },
        {
          "id": "retry-after-restart",
          "method": "POST",
          "path": "/events",
          "status": 200,
          "assertions": {
            "/duplicate": true
          },
          "body": {
            "id": "ev1",
            "type": "changed",
            "payload": {}
          }
        },
        {
          "id": "missing",
          "method": "GET",
          "path": "/events/missing",
          "status": 404,
          "assertions": {}
        }
      ]
    },
