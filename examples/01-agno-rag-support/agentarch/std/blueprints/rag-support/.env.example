# Copy to .env and fill in. .env is gitignored; committing it is what
# control.ai.api.secrets_not_committed blocks, and it is the most common way a provider
# credential reaches a public repository.
#
# Names here, values never. This file is committed precisely so that a new developer knows what to
# set without anyone having to send them a secret over chat.

# The provider credential. Set the one matching model.provider in the manifest; the other two can
# stay empty. All three are named here rather than only the one in use, so that switching provider
# is a change to the manifest and one line of .env rather than a hunt for what the variable is
# called — and so that a key for a provider this project is not configured to call is visibly
# unnecessary rather than quietly present.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional. Defaults are in the code; these exist so a deployment can tighten them without a
# release.
ENV=dev
LOG_LEVEL=INFO
AGENT_RUNS_PER_CALLER_PER_DAY=200
