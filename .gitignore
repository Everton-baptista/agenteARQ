# build output
/dist/
/bin/
*.exe
# the compiled binary at the repo root only. NOT anchored would also match every
# `agentarch/` directory the standard installs into a project — including the ones
# under examples/, which must be committed.
/agentarch

# go
*.test
*.out
/vendor/

# node (npm distribution wrapper only)
node_modules/

# python (pypi distribution wrapper only)
__pycache__/
*.egg-info/
/build/

# local tooling and editor state
.DS_Store
.idea/
.vscode/
*.swp

# assistant local state — the generated shims ARE committed, this is not
.claude/settings.local.json
.claude/worktrees/

# scratch
/tmp/
*.local.*

# built wheels
/dist-pypi/dist/
