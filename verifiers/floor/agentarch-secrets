#!/bin/sh
# Security floor: secret scanning of the staged source in /workspace.
#
# The configuration is the image's, never the project's. --config overrides any .gitleaks.toml
# in the source. gitleaks always loads {source}/.gitleaksignore and no flag turns that off
# (cmd/root.go in 8.30.1), so the wrapper removes it from /workspace first: that directory is
# the disposable in-container copy, never the project. Inline `gitleaks:allow` comments are
# honoured, because they sit on the reviewed line itself.
#
# Exit codes for the AgenteARQ runner: 0 clean, 1 secret found (failed), 125 scanner could not
# decide (inconclusive). Findings are redacted; no secret value is printed.
set -u
prefix=/opt/agentarch-floor
report=$(mktemp)
trap 'rm -f "$report"' 0

if [ -e .gitleaksignore ] || [ -L .gitleaksignore ]; then
  echo "secrets: the project's .gitleaksignore is not applied"
  rm -f ./.gitleaksignore || { echo "secrets: cannot discard .gitleaksignore; result inconclusive"; exit 125; }
fi

gitleaks dir . \
  --config "$prefix/gitleaks.toml" \
  --gitleaks-ignore-path "$prefix/no-ignore" \
  --redact --no-banner --no-color --log-level warn \
  --report-format json --report-path "$report" \
  --exit-code 2
code=$?

case $code in
  0) echo "secrets: no secrets found"; exit 0 ;;
  2) echo "secrets: secrets found (values redacted); remove them and rotate any real credential"; exit 1 ;;
  *) echo "secrets: scanner error (exit $code); result inconclusive"; exit 125 ;;
esac
