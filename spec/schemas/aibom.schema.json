{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentarch.dev/spec/1.0/aibom.schema.json",
  "title": "agentarch AI bill of materials",
  "description": "What an agent is made of. An SBOM lists packages; it omits the model, the prompt version, the corpus and the MCP servers, which is most of what determines how an agent behaves. Generated from the manifests, because one maintained by hand describes a system that used to exist.",
  "type": "object",
  "required": ["bom_format", "spec_version", "generated_at", "agents"],
  "additionalProperties": false,
  "properties": {
    "bom_format": { "const": "agentarch-aibom" },
    "spec_version": { "type": "string" },
    "generated_at": { "type": "string" },
    "generated_by": { "type": "string" },
    "note": { "type": "string" },

    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "components"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "stage": { "type": "string" },
          "system_type": { "type": "string" },
          "owner": { "type": "string" },
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "name"],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "enum": ["model", "prompt", "corpus", "tool", "mcp_server",
                           "embedding_model", "dataset", "package"]
                },
                "name": { "type": "string" },
                "version": { "type": "string" },
                "supplier": { "type": "string" },
                "sha256": { "type": "string" },
                "pinned": { "type": "boolean" },
                "properties": { "type": "object" }
              }
            }
          }
        }
      }
    }
  }
}
