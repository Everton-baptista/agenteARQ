{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Design direction as data (W3C DTCG 2025.10). Replace every value with the owner's chosen direction; generate platform code from this file and never edit that code by hand.",
  "$extensions": {
    "dev.agentarch": {
      "contrast": [
        { "fg": "{color.text}", "bg": "{color.bg}", "use": "text" },
        { "fg": "{color.text-muted}", "bg": "{color.bg}", "use": "text" },
        { "fg": "{color.on-accent}", "bg": "{color.accent}", "use": "ui" }
      ]
    }
  },
  "color": {
    "$type": "color",
    "bg": { "$value": { "colorSpace": "srgb", "components": [0.961, 0.965, 0.969], "hex": "#f5f6f7" } },
    "surface": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
    "text": { "$value": { "colorSpace": "srgb", "components": [0.122, 0.141, 0.165], "hex": "#1f242a" } },
    "text-muted": { "$value": { "colorSpace": "srgb", "components": [0.333, 0.357, 0.388], "hex": "#555b63" } },
    "accent": { "$value": { "colorSpace": "srgb", "components": [0.059, 0.369, 0.333], "hex": "#0f5e55" } },
    "on-accent": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } }
  },
  "font": {
    "body": {
      "$type": "fontFamily",
      "$value": ["Source Serif 4", "Georgia", "serif"],
      "$extensions": { "dev.agentarch": { "license": "OFL-1.1 via Google Fonts" } }
    },
    "ui": {
      "$type": "fontFamily",
      "$value": ["Public Sans", "system-ui", "sans-serif"],
      "$extensions": { "dev.agentarch": { "license": "OFL-1.1 via Google Fonts" } }
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 16, "unit": "px" } },
    "4": { "$value": { "value": 24, "unit": "px" } },
    "5": { "$value": { "value": 40, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "control": { "$value": { "value": 6, "unit": "px" } }
  },
  "motion": {
    "$type": "duration",
    "quick": { "$value": { "value": 150, "unit": "ms" } }
  }
}
