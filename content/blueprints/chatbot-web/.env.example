# Copy to .env and fill in. .env is gitignored; committing it is what
# control.ai.api.secrets_not_committed blocks, and it is the most common way a provider
# credential reaches a public repository.
#
# Names here, values never. This file is committed precisely so that a new developer knows what to
# set without anyone having to send them a secret over chat.

ANTHROPIC_API_KEY=

# Optional. Defaults are in the code; these exist so a deployment can tighten them without a
# release.
ENV=dev
LOG_LEVEL=INFO
AGENT_RUNS_PER_CALLER_PER_DAY=200
