# The credential lives here and must never be committed. control.ai.api.secrets_not_committed
# checks this file exists and that no .env is tracked — the most common way a provider key reaches
# a public repository is a single `git add -A` on the day someone is in a hurry.
.env
.env.local
.env.*.local

.venv/
__pycache__/
*.pyc
.pytest_cache/
